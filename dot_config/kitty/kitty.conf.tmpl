# Font
font_family      Iosevka Term
{{ if eq .machine "desktop" -}}
font_size        16.0
{{- else -}}
font_size        13.0
{{- end }}

# Window size and padding (big screen gets a bigger window)
remember_window_size  no
{{ if eq .machine "desktop" -}}
initial_window_width  160c
initial_window_height 50c
window_padding_width  8
{{- else -}}
initial_window_width  110c
initial_window_height 35c
window_padding_width  4
{{- end }}

# Shell (fish lives in different places on Mac and Linux)
{{ if eq .chezmoi.os "darwin" -}}
shell /opt/homebrew/bin/fish --login
{{- else -}}
shell /usr/bin/fish --login
{{- end }}

# General
scrollback_lines   10000
enable_audio_bell  no
cursor_shape       beam

# macOS: make Option work as Alt (needed for fzf's Alt-C and other shortcuts)
macos_option_as_alt yes
