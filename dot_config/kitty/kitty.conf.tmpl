

# Fonts
font_family         Iosevka Term
normal_font         Iosevka Term
bold_font           Iosevka Term Bold
italic_font         Iosevka Term Italic
bold_italic_font    Iosevka Term Bold Italic

{{ if eq .machine "desktop" -}}
font_size 15.0
{{- else -}}
font_size 12.0
{{- end }}

# Tabs and SCrollback
tab_bar_edge                    bottom
scrollback_lines                2000
scrollback_indicator_opacity    0.5

editor  /usr/local/bin/zed

shell /opt/homebrew/bin/fish --login

# BEGIN_KITTY_THEME
# Glacier
include current-theme.conf
# END_KITTY_THEME
